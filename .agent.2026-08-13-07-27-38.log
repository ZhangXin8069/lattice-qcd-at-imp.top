timestamp=2026-08-12T23:32:07.068Z level=INFO run=4dc24316 message=evaluated permission=bash pattern="python3 - <<'EOF'\nimport re\nsrc = open('static/js/fontawesome.all.min.js', encoding='utf-8').read()\ngen = open('static/js/fontawesome-subset.js', encoding='utf-8').read()\n# atom 提取结果\nm = re.search(r'atom:\\[(\\d+),(\\d+),\\[[^\\]]*\\],\"[^\"]*\",\"((?:[^\"\\\\]|\\\\.)*)\"', src)\nprint(\"提取正则命中 atom:\", bool(m))\nif m:\n    print(\"提取 path 前 60:\", m.group(3)[:60])\n    print(\"提取 path 长度:\", len(m.group(3)))\nm2 = re.search(r'atom:\\[(\\d+),(\\d+),\\[[^\\]]*\\],\"[^\"]*\",\"((?:[^\"\\\\]|\\\\.)*)\"', src)\n# 找所有 atom 出现\nfor mm in re.finditer(r'.{0,20}atom.{0,20}', src):\n    print(repr(mm.group(0)))\nEOF" action.permission=* action.action=allow action.pattern=*
