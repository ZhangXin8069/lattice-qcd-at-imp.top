timestamp=2026-08-12T23:30:41.122Z level=INFO run=4dc24316 message=evaluated permission=bash pattern="python3 - <<'EOF'\nimport re, os\nhtml = open('index.html', encoding='utf-8').read()\nrefs = re.findall(r'(?:href|src)=\"([^\"]+)\"', html)\nrefs = [r for r in refs if not r.startswith('#')]\ntotal = 0\nfor r in sorted(set(refs)):\n    p = r.split('?')[0].split('#')[0]\n    if os.path.isfile(p):\n        sz = os.path.getsize(p)\n        total += sz\n        print(f\"{sz/1024:10.1f} KB  {p}\")\n    else:\n        print(f\"{'CDN/外链':>10}    {r}\")\nprint(f\"{'='*10}\")\nprint(f\"本地资源合计: {total/1024/1024:.2f} MB\")\nEOF" action.permission=* action.action=allow action.pattern=*
