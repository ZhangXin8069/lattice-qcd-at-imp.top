timestamp=2026-08-12T23:32:13.040Z level=INFO run=4dc24316 message=evaluated permission=bash pattern="python3 - <<'EOF'\nimport re\nsrc = open('static/js/fontawesome.all.min.js', encoding='utf-8').read()\ngen = open('static/js/fontawesome-subset.js', encoding='utf-8').read()\nfor name in ['atom', 'moon']:\n    pat = re.compile(r'(?<![\\w\"])\"?\\b' + re.escape(name) + r'\"?:\\[(\\d+),(\\d+),\\[[^\\]]*\\],\"[^\"]*\",\"((?:[^\"\\\\]|\\\\.)*)\"')\n    allm = list(pat.finditer(src))\n    print(name, \"对比正则命中数:\", len(allm))\n    for m in allm[:3]:\n        print(\"  pos=%d len=%d path前20=%s\" % (m.start(), len(m.group(3)), m.group(3)[:20]))\n    # 生成文件里存的\n    gm = re.search(r'\"'+name+r'\":\\[(\\d+),(\\d+),\"((?:[^\"\\\\]|\\\\.)*)\"\\]', gen)\n    print(\"  生成文件 path前20:\", gm.group(3)[:20] if gm else None)\n    if allm:\n        print(\"  源首匹配与生成一致:\", allm[0].group(3) == gm.group(3))\nEOF" action.permission=* action.action=allow action.pattern=*
