timestamp=2026-08-12T23:31:59.411Z level=INFO run=4dc24316 message=evaluated permission=bash pattern="python3 - <<'EOF'\nimport re\nsrc = open('static/js/fontawesome.all.min.js', encoding='utf-8').read()\ngen = open('static/js/fontawesome-subset.js', encoding='utf-8').read()\npairs = re.findall(r'\"(\\w[\\w-]*)\":\\[(\\d+),(\\d+),\"((?:[^\"\\\\]|\\\\.)*)\"\\]', gen)\nok = 0\nfor name, w, h, path in pairs:\n    m = re.search(r'(?<![\\w\"])\"?\\b' + re.escape(name) + r'\":?\\[\\d+,\\d+,\\[[^\\]]*\\],\"[^\"]*\",\"((?:[^\"\\\\]|\\\\.)*)\"', src)\n    if m and m.group(1) == path:\n        ok += 1\n    else:\n        print(\"不一致:\", name)\nprint(f\"抽查: {ok}/{len(pairs)} 个图标 path 与源一致\")\nEOF" action.permission=* action.action=allow action.pattern=*
