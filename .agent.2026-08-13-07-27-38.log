timestamp=2026-08-12T23:41:14.682Z level=INFO run=4dc24316 message=evaluated permission=bash pattern="python3 - <<'EOF'\nfrom PIL import Image\nimport os\nImage.MAX_IMAGE_PIXELS = None\ntargets = [\n \"custom/张鑫 20260531工作汇报_01.png\",\"custom/课题组聚餐20260711.png\",\n \"custom/课题组合照20260706.png\",\"custom/刘柳明头像.png\",\"custom/孙鹏头像.png\",\n \"custom/孙鹏讲习图.png\",\"custom/刘柳明讲习图.png\",\"custom/张鑫讲习图.png\",\n \"custom/近代物理研究所惠州分部办公楼.png\",\"custom/李政道坐像.png\",\n \"custom/标准模型图.png\",\"custom/网站管理员.png\",\"custom/张鑫 20260706gitee贡献度.png\",\n]\nfor t in targets:\n    if not os.path.exists(t):\n        print(f\"缺失: {t}\"); continue\n    im = Image.open(t)\n    if im.size[0]*im.size[1] > 3e8:\n        print(f\"{os.path.getsize(t)/1024/1024:7.2f}MB  {im.size[0]}x{im.size[1]}  {im.mode}  超巨图(跳过采样)  {t}\")\n        continue\n    mode = im.mode\n    if 'A' in mode:\n        alpha = im.getchannel('A')\n        extrema = alpha.getextrema()\n        print(f\"{os.path.getsize(t)/1024/1024:7.2f}MB  {im.size[0]}x{im.size[1]}  {mode}  alpha范围={extrema}  {t}\")\n    else:\n        print(f\"{os.path.getsize(t)/1024/1024:7.2f}MB  {im.size[0]}x{im.size[1]}  {mode}  {t}\")\nEOF" action.permission=* action.action=allow action.pattern=*
